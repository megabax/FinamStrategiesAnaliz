# Подавление фонового шума Chrome (GCM, sync, SSL-логи в консоли):
# true  — тише (рекомендуется)
# false — обычное поведение Chrome
CHROME_SUPPRESS_BACKGROUND_NOISE=true

# Подключение к MSSQL (SQLAlchemy URL). Не коммитьте реальный hostname.
# Именованный инстанс: SERVER\INSTANCE, например localhost\SQLEXPRESS
DATABASE_URL=mssql+pyodbc://localhost/FinamStrategies?driver=ODBC Driver 17 for SQL Server&Trusted_Connection=yes

# Альтернатива: собрать URL из частей, если DATABASE_URL не задан
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=FinamStrategies
# MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# MSSQL_TRUSTED_CONNECTION=true
# MSSQL_USERNAME=
# MSSQL_PASSWORD=
